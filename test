<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog di Appunti</title>
    <link rel="stylesheet" href="styles.css"> <!-- Link al file CSS -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
        /* Stili base */
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f4f9;
            color: #333;
        }
        header {
            background-color: #2c3e50;
            color: white;
            text-align: center;
            padding: 1em 0;
        }
        nav ul {
            list-style-type: none;
            margin: 0;
            padding: 0;
            overflow: hidden;
            background-color: #333;
        }
        nav li {
            float: left;
        }
        nav li a {
            display: block;
            color: white;
            text-align: center;
            padding: 14px 16px;
            text-decoration: none;
        }
        nav li a:hover {
            background-color: #111;
        }
        .container {
            max-width: 80%;
            margin: auto;
            padding: 20px;
            background-color: white;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
        }
        .about-me {
            text-align: center;
            margin-bottom: 30px;
        }
        .courses-section {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
        }
        .course-card {
            width: calc(32% - 15px);
            background-color: #fff;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            margin-bottom: 20px;
            padding: 20px;
            border-radius: 8px;
            transition: transform 0.3s ease-in-out;
        }
        .course-card:hover {
            transform: scale(1.05);
        }
        .course-title {
            font-size: 1.5em;
            margin-bottom: 10px;
        }
        .demo-button, .download-button {
            display: inline-block;
            padding: 10px 20px;
            background-color: #2c3e50;
            color: white;
            text-decoration: none;
            border-radius: 4px;
            margin-top: 10px;
        }
        .demo-button:hover, .download-button:hover {
            background-color: #1d3549;
        }
    </style>
</head>
<body>

    <header>
        <h1>Blog di Appunti</h1>
    </header>

    <nav>
        <ul>
            <li><a href="#home">Home</a></li>
            <li><a href="#about">Chi Sono</a></li>
            <li><a href="#courses">Corsi</a></li>
        </ul>
    </nav>

    <!-- Sezione di Benvenuto -->
    <section id="home" class="container">
        <h2>Benvenuti sul mio Blog di Appunti!</h2>
        <p>In questo sito puoi trovare appunti e materiali didattici che condivido gratuitamente. Scaricali, studia e impara in modo semplice e accessibile.</p>
    </section>

    <!-- Sezione "Chi Sono" -->
    <section id="about" class="container">
        <h2>Chi Sono</h2>
        <div class="about-me">
            <img src="profile.jpg" alt="Immagine del Profilo" style="width: 150px; height: 150px; border-radius: 50%; margin-bottom: 10px;">
            <p>Io sono [Tuo Nome], studente di [Materie o Università]. Mi piace condividere i miei appunti e materiali didattici per aiutare altri a studiare meglio. Spero che troverai questo blog utile!</p>
        </div>
    </section>

    <!-- Sezione Corsi -->
    <section id="courses" class="container">
        <h2>Corsi</h2>
        <p>Scopri i miei appunti divisi per anni e corsi. Ogni corso ha una demo interattiva e un file PDF gratuito da scaricare.</p>

        <!-- Card dei Corsi -->
        <div class="courses-section">
            <!-- Esempio di card per un corso -->
            <div class="course-card">
                <h3 class="course-title">Anno 1 - Matematica</h3>
                <p>Appunti dettagliati sui principali argomenti di matematica per il primo anno.</p>
                <button class="demo-button" onclick="showDemo('math')">Visualizza Demo</button>
                <a href="matematica.pdf" download class="download-button">Scarica PDF</a>
            </div>

            <!-- Esempio di card per un altro corso -->
            <div class="course-card">
                <h3 class="course-title">Anno 2 - Fisica</h3>
                <p>Appunti dettagliati sui principali argomenti di fisica per il secondo anno.</p>
                <button class="demo-button" onclick="showDemo('physics')">Visualizza Demo</button>
                <a href="fisica.pdf" download class="download-button">Scarica PDF</a>
            </div>

            <!-- Esempio di card per un altro corso -->
            <div class="course-card">
                <h3 class="course-title">Anno 3 - Informatica</h3>
                <p>Appunti dettagliati sui principali argomenti di informatica per il terzo anno.</p>
                <button class="demo-button" onclick="showDemo('computer')">Visualizza Demo</button>
                <a href="informatica.pdf" download class="download-button">Scarica PDF</a>
            </div>

            <!-- Aggiungi altre card qui -->
        </div>
    </section>

    <!-- Modal per le demo interattive -->
    <div id="demoModal" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <h2>Demo Interattiva</h2>
            <p>Qui verrà mostrata una demo interattiva del corso selezionato.</p>
            <!-- Aggiungi qui il contenuto della demo -->
        </div>
    </div>

    <!-- Script per la gestione delle demo -->
    <script>
        // Funzione per mostrare la demo
        function showDemo(course) {
            document.getElementById('demoModal').style.display = 'block';
        }

        // Chiude la modale quando si clicca fuori o sul pulsante di chiusura
        var modal = document.getElementById('demoModal');
        window.onclick = function(event) {
            if (event.target == modal) {
                modal.style.display = "none";
            }
        };
    </script>

</body>
</html>
